# Copy to backend/.env.prod. Never commit the filled-in file.
SECRET_KEY=generate-a-50-char-random-string
DEBUG=False
ALLOWED_HOSTS=api.example.com

# Supabase: Project Settings -> Database -> Connection string -> URI.
# Pooler host (:6543) for app traffic; direct host (:5432) for migrations.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Comma separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com

# Set False only when TLS terminates in front of the container without
# forwarding X-Forwarded-Proto.
SECURE_SSL_REDIRECT=True
LOG_LEVEL=INFO
