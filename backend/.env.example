# Copy to backend/.env and fill in. Never commit .env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*

# Local dev uses the `db` service from docker-compose.yml:
DATABASE_URL=postgresql://postgres:postgres@db:5432/mizan
#
# Production/staging uses Supabase Postgres:
# Project Settings -> Database -> Connection string -> URI
# Use the pooler host (port 6543) for app traffic, direct host (5432) for migrations.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Comma separated; ignored while DEBUG=True (all origins allowed).
CORS_ALLOWED_ORIGINS=
